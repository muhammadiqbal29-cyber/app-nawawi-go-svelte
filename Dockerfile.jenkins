FROM jenkins/jenkins:lts
USER root

# Install dependencies for Golang and Node.js
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    rsync \
    ssh \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Golang (v1.21.0)
RUN wget https://go.dev/dl/go1.21.0.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.21.0.linux-amd64.tar.gz && \
    rm go1.21.0.linux-amd64.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"

# Install Node.js (v20.x)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Gosec for Security Audit
RUN curl -sfL https://raw.githubusercontent.com/securego/gosec/master/install.sh | sh -s -- -b /usr/local/bin v2.17.0

# Revert to jenkins user
USER jenkins
